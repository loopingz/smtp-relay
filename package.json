{
  "name": "smtp-relay",
  "version": "2.3.0",
  "main": "lib/index.js",
  "bin": "lib/index.js",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "Remi Cattiau",
    "email": "remi@cattiau.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/loopingz/smtp-relay"
  },
  "keywords": [
    "smtp",
    "relay",
    "ses"
  ],
  "overrides": {
    "fast-xml-parser": ">=5.11.1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/client-ses": "^3.1132.0",
    "@aws-sdk/client-sqs": "^3.1132.0",
    "@aws-sdk/client-sts": "^3.1132.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/storage": "^8.1.0",
    "@webda/workout": "^3.2.1",
    "cloudevents": "^10.0.0",
    "fast-xml-parser": ">=5.11.1",
    "is-in-subnet": "^4.0.1",
    "mailauth": "^5.0.3",
    "mailparser": "^3.9.26",
    "nodemailer": "^10.0.10",
    "prom-client": "^15.1.3",
    "semver": ">=7.8.5",
    "smtp-server": "^3.19.12",
    "strip-json-comments": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc",
    "build:binaries": "esbuild ./src/index.ts --bundle --platform=node --outfile=bin/smtp-relay.cjs && node --experimental-sea-config sea-config.json",
    "build:schema": "ts-json-schema-generator -f ./tsconfig.json --type 'SmtpConfig' -o config.schema.json",
    "pretest": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check src/**/*",
    "lint:fix": "prettier --write src/**/*",
    "test": "c8 mocha --recursive --exit --timeout=6000 'lib/**/*.spec.js'",
    "test:debug": "mocha --node-option import=tsx --recursive --exit --no-timeouts 'src/**/*.spec.ts'",
    "server": "tsc && node lib/index.js",
    "release": "yarn build && yarn build:schema && auto shipit"
  },
  "c8": {
    "report-dir": "./reports",
    "reporter": [
      "html",
      "lcov",
      "json",
      "text"
    ],
    "exclude": [
      "**/*.spec.ts"
    ],
    "excludeNodeModules": true,
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "branches": 100,
    "statements": 100,
    "excludeAfterRemap": true
  },
  "devDependencies": {
    "@auto-it/all-contributors": "^11.3.6",
    "@auto-it/conventional-commits": "^11.3.6",
    "@auto-it/first-time-contributor": "^11.3.6",
    "@testdeck/mocha": "^0.3.3",
    "@types/mailparser": "^3.4.6",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.0",
    "@types/smtp-server": "^3.5.13",
    "auto": "^11.3.6",
    "axios": "^1.20.0",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "mocha": "^12.0.1",
    "prettier": "^3.9.6",
    "selfsigned": "^5.5.0",
    "sinon": "^22.1.0",
    "ts-json-schema-generator": "^2.5.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "auto": {
    "plugins": [
      "npm",
      "all-contributors",
      "conventional-commits",
      "first-time-contributor",
      "released"
    ],
    "baseBranch": "main",
    "prereleaseBranches": [
      "next"
    ],
    "author": "GitHub Actions Bot <github-bot@loopingz.com>",
    "onlyPublishWithReleaseLabel": false
  }
}
