{
  "compilerOptions": {
    "target": "es2020",
    "lib": [
      "es2019",
      "DOM"
    ],
    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./lib",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "**/node_modules"
  ]
}